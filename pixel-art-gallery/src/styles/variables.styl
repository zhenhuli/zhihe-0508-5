$bg-color = #f8fafc
$bg-color-dark = #0f172a

$header-bg = #ffffff
$header-bg-dark = #1e293b

$card-bg = #ffffff
$card-bg-dark = #1e293b

$text-color = #1e293b
$text-color-dark = #f1f5f9

$text-secondary = #64748b
$text-secondary-dark = #94a3b8

$border-color = #e2e8f0
$border-color-dark = #334155

$hover-bg = #f1f5f9
