
*
	box-sizing border-box

html, body
	margin 0
	padding 0
	min-height 100vh
	overflow-y auto

body
	font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif
	line-height 1.6
	-webkit-font-smoothing antialiased
	-moz-osx-font-smoothing grayscale

button
	font inherit
	cursor pointer
	border none
	outline none

img
	display block
	max-width 100%
	height auto
